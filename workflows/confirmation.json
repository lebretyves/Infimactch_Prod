{
  "id": "InfiMatchConfirm",
  "name": "InfiMatch - Mission confirmation",
  "active": false,
  "nodes": [
    {
      "id": "webhook-confirmation",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "infimatch-confirmation",
      "parameters": {
        "httpMethod": "POST",
        "path": "confirmation",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "authorize",
      "name": "Authorize",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "token",
              "leftValue": "={{ $json.headers['x-infimatch-token'] }}",
              "rightValue": "={{ $env.INFIMATCH_SERVICE_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "backend",
      "name": "Backend action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INFIMATCH_API + '/internal/automation/confirmation/' + $json.body.eventId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-InfiMatch-Token",
              "value": "={{ $env.INFIMATCH_SERVICE_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "reply",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        670,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "deny",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        440,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"code\":\"UNAUTHORIZED\"}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Authorize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorize": {
      "main": [
        [
          {
            "node": "Backend action",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend action": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "versionId": "f74b30ce-f185-4536-b0c2-133bde787cfa",
  "tags": []
}
