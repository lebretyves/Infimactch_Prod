{
  "name": "@infimatch/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc-watch --project tsconfig.build.json --onSuccess \"node --use-system-ca dist/main.js\"",
    "start": "node --use-system-ca dist/main.js",
    "db:migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "test": "npm run test:compile && node --test \".test-build/test/unit/*.spec.js\"",
    "test:integration": "npm run test:compile && node ../scripts/security/test-suite.cjs integration",
    "coverage": "npm run test:compile && c8 --all --src=src --extension=.ts --include=\"src/**\" --include=\".test-build/src/**\" --reporter=text --reporter=json-summary --reporter=html --reports-dir=../docs/proofs/coverage node ../scripts/security/test-suite.cjs coverage",
    "test:compile": "tsc --outDir .test-build",
    "worker": "node --use-system-ca dist/worker.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/swagger": "12.0.1",
    "@vercel/functions": "3.9.8",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "commander": "15.0.0",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.4.2",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "google-auth-library": "^11.0.2",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "mongoose": "8.24.4",
    "multer": "2.3.0",
    "openid-client": "6.8.8",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stream-chain": "4.2.5",
    "stream-json": "3.6.0",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/luxon": "3.7.5",
    "@types/node": "24.13.4",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "c8": "12.0.0",
    "expect": "30.5.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "imports": {
    "#standard-fonts/*": "pdfkit/standard-fonts/*"
  }
}
