{
  "name": "InfiMatch production - confirmation",
  "nodes": [
    {
      "id": "4070f2ba-3c44-4fc9-9c22-05bb18127ed7",
      "name": "Reception",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "1b636c2e-4eab-4a1a-b6f9-e97edf3972c0",
      "parameters": {
        "httpMethod": "POST",
        "path": "infimatch-prod/confirmation",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "a87d7bad-322f-43ff-b40a-c92d9673aad7",
      "name": "Valider evenement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const id=$json.body?.eventId;if(typeof id!=='string'||!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id))throw new Error('Invalid event');return [{json:{eventId:id}}];"
      }
    },
    {
      "id": "097d2e9d-3158-4e60-9ee9-c8bf647c717d",
      "name": "Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://infimactch-prod-backend.vercel.app/api/v1/internal/automation/confirmation/\" + $json.eventId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "X-N8N-Workflow-Id",
              "value": "={{ $workflow.id }}"
            }
          ]
        },
        "options": {
          "timeout": 240000
        }
      }
    }
  ],
  "connections": {
    "Reception": {
      "main": [
        [
          {
            "node": "Valider evenement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valider evenement": {
      "main": [
        [
          {
            "node": "Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
