    },
    {
      "id": "61afc756-9f83-45ab-b9e0-0cf858cbaff1",
      "name": "Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://infimactch-prod-backend.vercel.app/api/v1/internal/automation/confirmation/\" + $json.eventId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 240000
        }
      }
    }
  ],
  "connections": {
