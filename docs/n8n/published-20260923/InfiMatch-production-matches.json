{
  "name": "InfiMatch production - matches",
  "nodes": [
    {
      "id": "393a82f0-f9ec-44f1-8d79-abcdff08471e",
      "name": "Reception",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "1b38af88-74e5-4629-8083-c4eebe553a81",
      "parameters": {
        "httpMethod": "POST",
        "path": "infimatch-prod/matches",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "6f73de9b-352b-42a9-a185-fad5b87161b4",
      "name": "Valider evenement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const id=$json.body?.eventId;if(typeof id!=='string'||!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id))throw new Error('Invalid event');return [{json:{eventId:id}}];"
      }
    },
    {
      "id": "f2016a5a-0fef-4728-9c70-091f52290243",
      "name": "Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://infimactch-prod-backend.vercel.app/api/v1/internal/automation/matches/\" + $json.eventId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "X-N8N-Workflow-Id",
              "value": "={{ $workflow.id }}"
            }
          ]
        },
        "options": {
          "timeout": 240000
        }
      }
    }
  ],
  "connections": {
    "Reception": {
      "main": [
        [
          {
            "node": "Valider evenement",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valider evenement": {
      "main": [
        [
          {
            "node": "Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
