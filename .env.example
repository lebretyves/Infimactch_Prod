NODE_ENV=development
PORT=3100
APP_ORIGIN=http://127.0.0.1:5173
# Required in production: exact proxy IP/CIDR, trusted subnet name, or hop count.
TRUST_PROXY=
DATABASE_URL=postgresql://infimatch:GENERATE_LOCALLY@127.0.0.1:55432/infimatch
MONGODB_URI=mongodb://infimatch:GENERATE_LOCALLY@127.0.0.1:57017/infimatch?authSource=admin
SESSION_SECRET=GENERATE_LOCALLY
DOCUMENT_KEY=GENERATE_BASE64_32_BYTES
DOCUMENT_QUOTA_BYTES=26214400
SERVICE_TOKEN=GENERATE_LOCALLY
POSTGRES_PASSWORD=GENERATE_LOCALLY
MONGO_PASSWORD=GENERATE_LOCALLY
N8N_ENCRYPTION_KEY=GENERATE_LOCALLY
RPPS_API_KEY=
FT_CLIENT_ID=
FT_CLIENT_SECRET=
N8N_WEBHOOK_BASE=http://127.0.0.1:55678/webhook

# Optional public Google Identity Services client ID; empty disables Google login.
GOOGLE_CLIENT_ID=
JOBSPIPE_API_KEY=

# Leave empty until the business history retention policy is validated.
BUSINESS_HISTORY_RETENTION_DAYS=

# Browser-facing n8n URL; set to its HTTPS address after deployment.
N8N_EDITOR_BASE_URL=http://localhost:55678

# Discord optional notifications: values provisioned locally, never commit real secrets.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional trusted local CA inside n8n; leave empty on hosts without TLS inspection.
N8N_EXTRA_CA_CERTS=
DISCORD_TEST_GUILD_ID=
DISCORD_TEST_CHANNEL_ID=
DISCORD_TEST_USER_ID=

# Local administration browser origin (Vite).
ADMIN_ORIGIN=http://127.0.0.1:5175
# PSC requires official ANS onboarding and separate sandbox credentials.
PSC_ENABLED=false
PSC_ENVIRONMENT=sandbox
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
# Empty preserves existing directory behavior; false disables it independently.
RPPS_ENABLED=
# School demonstration only: accept applications/assignments without verified RPPS.
# Does not mark profiles as verified; keep false for a real recruitment service.
DEMO_OPTIONAL_RPPS=false
DOCUMENT_STORAGE=filesystem

# Mission confirmation/cancellation emails. Store real values in Vault and Vercel.
SMTP2GO_API_KEY=
SMTP2GO_FROM=
# Independent random bearer secret (32+ characters); same value in the JSON webhook settings.
SMTP2GO_WEBHOOK_SECRET=

# Local operator tools only; absolute private paths, never bundled into frontend.
INFIMATCH_VAULT_PRIVATE_DIR=
INFIMATCH_BACKUP_DIRECTORY=
