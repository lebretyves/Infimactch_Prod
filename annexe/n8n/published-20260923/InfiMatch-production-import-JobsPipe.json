{
  "name": "InfiMatch production - import JobsPipe",
  "nodes": [
    {
      "id": "b105e8e5-b600-4b41-807b-b8bc4d90a8f3",
      "name": "Horaires Paris",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 7 * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "5c58b561-e659-4fcf-89c1-380b9666b9d4",
      "name": "Importer un lot",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://infimactch-prod-backend.vercel.app/api/v1/internal/automation/jobs/refresh-offers/JOBSPIPE",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "X-N8N-Workflow-Id",
              "value": "={{ $workflow.id }}"
            }
          ]
        },
        "options": {
          "timeout": 240000
        }
      },
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "ebfbfb2c-e1d4-49fe-8998-cc476683a0da",
      "name": "Decider la reprise",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const status=$json.status;\nconst allowed=['SUCCESS','IN_PROGRESS','UP_TO_DATE','COOLDOWN','PAUSED','BUSY','QUOTA_EXHAUSTED','RETRY_REQUIRED','INCOMPLETE','AUTH_REQUIRED'];\nif(!allowed.includes(status))throw new Error('IMPORT_RESPONSE_INVALID');\nif(status==='INCOMPLETE'||status==='AUTH_REQUIRED')throw new Error('IMPORT_'+status);\nconst previous=$runIndex>0?$items('Decider la reprise',0,$runIndex-1)[0].json.failures:0;\nconst failures=previous+(status==='RETRY_REQUIRED'?1:0);\nif(failures>2)throw new Error('IMPORT_RETRY_LIMIT_REACHED');\nconst hasMore=status==='IN_PROGRESS'||status==='RETRY_REQUIRED';\nif(hasMore&&$runIndex>=19)throw new Error('IMPORT_BATCH_LIMIT_REACHED_CHECKPOINT_SAVED');\nreturn [{json:{...$json,hasMore,failures,waitSeconds:status==='RETRY_REQUIRED'?300:1}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "2072ab58-69e8-4b4d-850d-4f8f02beedae",
      "name": "Encore des pages",
      "type": "n8n-nodes-base.if",
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "30255d92-427e-4e9f-832c-ef01a368d22b",
              "leftValue": "={{ $json.hasMore }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "typeVersion": 2.2
    },
    {
      "id": "f3e2e7fb-96c5-436c-8895-822139d67b8d",
      "name": "Attendre avant reprise",
      "type": "n8n-nodes-base.wait",
      "position": [
        960,
        -80
      ],
      "parameters": {
        "amount": "={{ $json.waitSeconds }}",
        "unit": "seconds"
      },
      "typeVersion": 1.1,
      "webhookId": "8cb8c6f1-6143-4119-afcb-bce1df520af7"
    }
  ],
  "connections": {
    "Horaires Paris": {
      "main": [
        [
          {
            "node": "Importer un lot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Importer un lot": {
      "main": [
        [
          {
            "node": "Decider la reprise",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decider la reprise": {
      "main": [
        [
          {
            "node": "Encore des pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encore des pages": {
      "main": [
        [
          {
            "node": "Attendre avant reprise",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Attendre avant reprise": {
      "main": [
        [
          {
            "node": "Importer un lot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris",
    "executionTimeout": 3600,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
