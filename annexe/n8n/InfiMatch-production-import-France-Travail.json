            "index": 0
          }
        ]
      ]
    },
    "Decider la reprise": {
      "main": [
        [
          {
            "node": "Encore des pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encore des pages": {
      "main": [
        [
          {
            "node": "Attendre avant reprise",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Attendre avant reprise": {
      "main": [
        [
          {
            "node": "Importer un lot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris",
    "executionTimeout": 3600,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  }
}
