{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/aide",
      "destination": "/aide.html"
    },
    {
      "source": "/installer",
      "destination": "/installer.html"
    },
    {
      "source": "/accessibilite",
      "destination": "/accessibilite.html"
    },
    {
      "source": "/ecoconception",
      "destination": "/ecoconception.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://infimactch-prod-backend.vercel.app/api/:path*"
    },
    {
      "source": "/:path(accueil|connexion|mot-de-passe-oublie|reinitialiser-mot-de-passe|compte|inscription(?:/.*)?|notifications|missions(?:/.*)?|candidatures(?:/.*)?|calendrier|profil|dossier|favoris|etablissements/[^/]+|historique|affectations/[^/]+/preparation-contrat|organisation|mes-etablissements|besoins|gestion/missions/[^/]+(?:/modifier)?)",
      "destination": "/private.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://infimactch-prod-backend.vercel.app https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; media-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://infimactch-prod-backend.vercel.app https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; media-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/:path((?!installer$|accessibilite$|ecoconception$|mentions-legales$).+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/:path(aide|accueil|connexion|mot-de-passe-oublie|reinitialiser-mot-de-passe|compte|inscription(?:/.*)?|notifications|missions(?:/.*)?|candidatures(?:/.*)?|calendrier|profil|dossier|favoris|etablissements/[^/]+|historique|affectations/[^/]+/preparation-contrat|organisation|mes-etablissements|besoins|gestion/missions/[^/]+(?:/modifier)?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/private.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/aide.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/catalogue/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/apercu-annonces/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
