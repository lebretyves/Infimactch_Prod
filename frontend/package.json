{
  "name": "interimatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/public-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/build-icon-sprite.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "build:quality": "npm run build && npm run measure:build",
    "build:demo": "tsc -b && vite build --base ./ --outDir dist-demo --mode demo",
    "test": "node --test scripts/test-api.mjs && node --experimental-strip-types --test scripts/test-idle-session.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:signup": "node scripts/test-signup.mjs",
    "test:availability": "node --experimental-strip-types scripts/test-availability-slots.mjs",
    "test:datetime": "node --experimental-strip-types scripts/test-paris-datetime.mjs",
    "test:pwa": "node --test scripts/test-pwa.mjs",
    "test:quality": "node scripts/test-quality.mjs",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
